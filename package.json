{
  "name": "relation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/build-graph.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "graph:check": "cargo run --manifest-path engine/Cargo.toml --quiet -- src/lib/data/graph.json && cargo run --manifest-path engine/Cargo.toml --quiet -- src/lib/data/graph.en.json"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "svelte": "^5.59.1"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "playwright-core": "^1.58.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}

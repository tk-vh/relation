[
  {
    "source": "zhuangzi",
    "target": "laozi",
    "kind": "influences",
    "reason": "以齐物与逍遥继承老子之道，将无为与自然化为个体的精神自由。"
  },
  {
    "source": "mencius",
    "target": "confucius",
    "kind": "influences",
    "reason": "以四端之心与性善论深化孔子的仁，并将仁落实为仁政王道。"
  },
  {
    "source": "mozi",
    "target": "confucius",
    "kind": "refutes",
    "reason": "以兼爱反对儒家亲亲有差等的爱，并讥评厚葬与礼乐之奢费。"
  },
  {
    "source": "xunzi",
    "target": "confucius",
    "kind": "influences",
    "reason": "继承孔子的礼与学，以礼义化性起伪而重塑儒家的修身成德。"
  },
  {
    "source": "xunzi",
    "target": "mencius",
    "kind": "refutes",
    "reason": "以性恶论反驳孟子的性善，主张善出于人为的礼义而非本然。"
  },
  {
    "source": "xunzi",
    "target": "zhuangzi",
    "kind": "refutes",
    "reason": "批评庄子“蔽于天而不知人”，主张重人事礼义而非任其自然。"
  },
  {
    "source": "xunzi",
    "target": "mozi",
    "kind": "refutes",
    "reason": "批评墨子“蔽于用而不知文”，以礼乐之文反对其功利节用。"
  },
  {
    "source": "xunzi",
    "target": "laozi",
    "kind": "refutes",
    "reason": "批评老子“有见于诎无见于信”，反对其贵柔退让而失进取。"
  },
  {
    "source": "mencius",
    "target": "mozi",
    "kind": "refutes",
    "reason": "斥墨子“兼爱无父”，以等差之爱与亲亲反对无差别的兼爱。"
  },
  {
    "source": "hanfeizi",
    "target": "xunzi",
    "kind": "influences",
    "reason": "师承荀子而弃其礼治，从性恶引出以法治与赏罚治国的术势。"
  },
  {
    "source": "hanfeizi",
    "target": "laozi",
    "kind": "synthesizes",
    "reason": "以《解老》《喻老》将道转化为法家的术与势，化无为为君术。"
  },
  {
    "source": "hanfeizi",
    "target": "confucius",
    "kind": "refutes",
    "reason": "以法、术、势反对儒家的德治与礼治，主张以赏罚取代教化。"
  },
  {
    "source": "hanfeizi",
    "target": "mozi",
    "kind": "refutes",
    "reason": "在《显学》中与儒家并斥墨家的兼爱与贤治，主张以法、术、势取代德教。"
  },
  {
    "source": "zhuangzi",
    "target": "confucius",
    "kind": "refutes",
    "reason": "以诙谐寓言讥讽儒家的仁义礼乐，主张超越名教而返于自然。"
  },
  {
    "source": "zhuxi",
    "target": "confucius",
    "kind": "influences",
    "reason": "以四书为本继承孔子的仁学与礼，并将其纳入理气的心性论。"
  },
  {
    "source": "zhuxi",
    "target": "mencius",
    "kind": "influences",
    "reason": "以孟子的四端之心为理气宇宙论的心性基础，并吸收程颐的理本论。"
  },
  {
    "source": "zhuxi",
    "target": "xunzi",
    "kind": "refutes",
    "reason": "以“性即理”反对荀子的性恶，斥其只见气质而不见本然之性。"
  },
  {
    "source": "zhuxi",
    "target": "buddha",
    "kind": "refutes",
    "reason": "以实理与伦理批判佛教的空寂，斥其遗弃人伦而堕于虚无。"
  },
  {
    "source": "zhuxi",
    "target": "laozi",
    "kind": "refutes",
    "reason": "批评道家的无与自然破坏纲常，以太极之理取代其虚无本原。"
  },
  {
    "source": "wang",
    "target": "zhuxi",
    "kind": "refutes",
    "reason": "以心即理、知行合一反对朱熹的格物穷理与先知后行之支离。"
  },
  {
    "source": "wang",
    "target": "mencius",
    "kind": "influences",
    "reason": "以良知直承孟子之良心与四端，发展为致良知的工夫论。"
  },
  {
    "source": "wang",
    "target": "confucius",
    "kind": "influences",
    "reason": "以良知贯通孔子的仁与诚，回归心性本体的内圣成德之学。"
  },
  {
    "source": "wang",
    "target": "buddha",
    "kind": "refutes",
    "reason": "批评佛教耽于空寂而遗弃人伦，以良知之实取代其虚无。"
  },
  {
    "source": "nagarjuna",
    "target": "buddha",
    "kind": "presupposes",
    "reason": "以中观展开“缘起即空”，视空性为佛陀缘起与中道教义的深化。"
  },
  {
    "source": "vasubandhu",
    "target": "buddha",
    "kind": "influences",
    "reason": "以唯识与阿赖耶识阐释佛陀的无我与缘起，将业识理论化。"
  },
  {
    "source": "vasubandhu",
    "target": "nagarjuna",
    "kind": "influences",
    "reason": "以三性说重述缘起与空，但保持唯识与中观的分野，并未真正综合两派。"
  },
  {
    "source": "dharmakirti",
    "target": "buddha",
    "kind": "presupposes",
    "reason": "以刹那灭与无我承佛陀的无常无我教义，为其建立量证。"
  },
  {
    "source": "dharmakirti",
    "target": "vasubandhu",
    "kind": "influences",
    "reason": "承世亲一系的识论与因明，将现量与比量体系化为有效认知。"
  },
  {
    "source": "dogen",
    "target": "buddha",
    "kind": "presupposes",
    "reason": "以佛性即修行的展开为基，主张修证一如，反对本觉式的现成佛性。"
  },
  {
    "source": "dogen",
    "target": "nagarjuna",
    "kind": "influences",
    "reason": "以中观的空性融入禅法，发展“有时”与修证一如的洞见。"
  },
  {
    "source": "shankara",
    "target": "buddha",
    "kind": "refutes",
    "reason": "以梵我同一与常我破佛教的无我与刹那灭，斥其为断见。"
  },
  {
    "source": "shankara",
    "target": "nagarjuna",
    "kind": "refutes",
    "reason": "在《梵经注》中批驳中观以空破一切，坚持梵我常住的实在论。"
  },
  {
    "source": "ramanuja",
    "target": "shankara",
    "kind": "refutes",
    "reason": "以限定不二反对摩耶论，主张世界与灵魂真实且为神之身体。"
  },
  {
    "source": "ramanuja",
    "target": "buddha",
    "kind": "refutes",
    "reason": "以梵神与个体灵魂之实破佛教的无我，捍卫人格神的虔信。"
  },
  {
    "source": "nishida",
    "target": "buddha",
    "kind": "influences",
    "reason": "以纯粹经验与绝对无会通禅与佛教的空，主客未分即是真如。"
